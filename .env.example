PORT=3000

# Choose: gemini, openai-compatible, openrouter, openai, groq, together, custom, or none
# If AI_PROVIDER is blank, the server uses Gemini when GEMINI_API_KEY exists,
# otherwise it uses OpenAI-compatible mode when AI_API_KEY exists.
AI_PROVIDER=openrouter
AI_API_KEY=your_provider_api_key_here
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=your-provider-model-id

# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Hope Seeker AI

# Gemini-specific key; needed only when AI_PROVIDER=gemini (audio can be sent directly to Gemini)
# GEMINI_API_KEY=your_gemini_api_key_here
